{
  "name": "dependency-advisor",
  "displayName": "Dependency Advisor",
  "description": "Project aware dependency discovery and verification",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dependency-advisor.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "dependency-advisor.inspectCurrentProject",
        "title": "Dependency Advisor: Inspect Current Project"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "test:extension": "npm run compile && npm run lint && vscode-test",
    "lint": "eslint src"
},

  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.145.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0"
  }
}
